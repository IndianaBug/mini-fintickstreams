        // Resolve WS stream from exchange configs
        // ------------------------------------------------------------
        let deps_for_closure = deps.clone();

        let exchange_cfgs = deps.exchange_cfgs.clone();
        let cfg = exchange_cfgs
            .bybit_linear
            .as_ref()
            .expect("bybit_linear config must exist");

