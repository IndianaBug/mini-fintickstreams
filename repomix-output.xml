        println!("ParamPlacement str 'binance_linear' -> {:?}", p_bin_s);
        println!("ParamPlacement str 'hyperliquid_perp' -> {:?}", p_hl_s);
        assert_eq!(p_bin_s, ParamPlacement::Query);
        assert_eq!(p_hl_s, ParamPlacement::JsonBody);

        // -----------------------------
