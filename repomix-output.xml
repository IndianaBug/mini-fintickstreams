            (
                ExchangeId::BinanceLinear,
                StreamTransport::Ws,
                StreamKind::L2Book,
                "depth_update",
            ),
            (
                ExchangeId::BinanceLinear,
                StreamTransport::Ws,
                StreamKind::Trades,
                "trades",
            ),
            (
                ExchangeId::BinanceLinear,
                StreamTransport::Ws,
                StreamKind::Liquidations,
                "liquidations",
            ),
            // Hyperliquid HTTP
            (
                ExchangeId::HyperliquidPerp,
                StreamTransport::HttpPoll,
                StreamKind::L2Book,
                "depth",
