        // -----------------------------
        // 3) ParamPlacement rules
        // -----------------------------
        println!("\n================= PARAM PLACEMENT =================");

        let p_bin = ParamPlacement::for_exchange(ExchangeId::BinanceLinear);
        let p_hl = ParamPlacement::for_exchange(ExchangeId::HyperliquidPerp);
