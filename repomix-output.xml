        }

        // _str variant smoke
        let ws =
            resolve_ws_stream_str(&exchange_cfgs, "hyperliquid_perp", StreamKind::Trades).unwrap();
        println!(
            "[WS str] hyperliquid_perp Trades => stream_title={:?} coin={:?} subscription_type={:?}",
            ws.stream_title, ws.coin, ws.subscription_type
        );

        println!("\n================= DONE =================");
    }

